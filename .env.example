# ===================================================
# E-FIR MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Authentication Secrets
JWT_SECRET=efir_super_secure_jwt_secret_key_2026_change_in_production
JWT_EXPIRES_IN=24h

# Database Configuration (Optional external PostgreSQL)
# If left empty, the server automatically defaults to the embedded persistent PGlite PostgreSQL engine
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/efir_db
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=efir_db

# File Upload Configuration
MAX_FILE_SIZE_MB=50

# Nodemailer / Email Service (Optional: Fallbacks to console logging in dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="E-FIR National Portal" <no-reply@efir.gov.in>
